{
  "name": "mixcore-totp",
  "version": "1.0.0",
  "title": "身份验证",
  "description": "TOTP 身份验证码（内置应用迁移，数据自包含）",
  "author": "dilong",
  "icon": "icon.svg",
  "entry": "dist/index.html",
  "devEntry": "http://localhost:5181",
  "window": {
    "width": 1000,
    "height": 700,
    "resizable": true,
    "minimizable": true,
    "maximizable": true
  },
  "permissions": ["db", "store", "events", "clipboard", "window"],
  "ui": { "mode": "window" },
  "data": { "engine": "lmdb" }
}
